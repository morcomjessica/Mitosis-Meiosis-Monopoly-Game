<script>
/* ══════════════════════════════════════
   CONSTANTS
══════════════════════════════════════ */
const TEAM_COLORS = ['#ef4444','#3b82f6','#22c55e','#a855f7','#f59e0b','#06b6d4'];
const TEAM_DEFAULTS = ['Team 1','Team 2','Team 3','Team 4','Team 5','Team 6'];
let teamCount = 2;

/* ══════════════════════════════════════
   SETUP
══════════════════════════════════════ */
function buildTeamsList() {
  const el = document.getElementById('teams-list');
  el.innerHTML = '';
  for (let i = 0; i < teamCount; i++) {
    const row = document.createElement('div');
    row.className = 'team-row';
    const rmBtn = teamCount > 2
      ? `<button class="rm-btn" onclick="removeTeam(${i})" title="Remove">×</button>`
      : '';
    row.innerHTML = `
      <div class="team-swatch" style="background:${TEAM_COLORS[i]}"></div>
      <input type="text" id="tn${i}" value="${TEAM_DEFAULTS[i]}" autocomplete="off">
      ${rmBtn}`;
    el.appendChild(row);
  }
  document.getElementById('add-team-btn').style.display = teamCount >= 6 ? 'none' : 'block';
}
function addTeam() { if (teamCount < 6) { teamCount++; buildTeamsList(); } }
function removeTeam(i) {
  if (teamCount <= 2) return;
  // Read current values before rebuilding
  for (let j = 0; j < teamCount; j++) {
    const el = document.getElementById('tn' + j);
    if (el) TEAM_DEFAULTS[j] = el.value;
  }
  TEAM_DEFAULTS.splice(i, 1);
  TEAM_DEFAULTS.push('Team ' + (teamCount));
  teamCount--;
  buildTeamsList();
}
buildTeamsList();

/* ══════════════════════════════════════
   BOARD DEFINITION
══════════════════════════════════════ */
const BOARD_SIZE = 40;
const SP_TYPES = [
  'start','question','question','question','challenge','question','question','challenge','bonus','question',
  'corner','question','challenge','question','question','penalty','question','question','challenge','corner',
  'question','question','challenge','question','question','challenge','question','question','challenge','corner',
  'question','question','challenge','question','question','penalty','question','question','challenge','corner'
];
const SP_LABELS = [
  'GO','Cell\nCycle','Interphase','Mitosis','CHALLENGE','DNA\nReplic.','Chromosomes','CHALLENGE','BONUS!','Cell\nCycle',
  'CORNER','Prophase','CHALLENGE','Metaphase','Anaphase','PENALTY','Telophase','Cytokinesis','CHALLENGE','CORNER',
  'Meiosis','Diploid','CHALLENGE','Haploid','Gametes','CHALLENGE','Meiosis I','Meiosis II','CHALLENGE','CORNER',
  'Prophase I','Crossing\nOver','CHALLENGE','Metaphase I','Anaphase I','PENALTY','Telophase I','Genes','CHALLENGE','CORNER'
];
const SP_EMOJI = [
  '🧬','🔄','🔬','🔵','🔥','🧪','🔗','🔥','⭐','⏱️',
  '🟣','📐','🔥','📏','➡️','💀','📦','✂️','🔥','🟣',
  '🔀','2️⃣','🔥','1️⃣','🥚','🔥','➗','🔁','🔥','🟣',
  '🌀','✖️','🔥','🟰','↕️','💀','📦','🧬','🔥','🟣'
];
const SP_FILL   = {start:'#1e3a5f',question:'#0d1f3c',challenge:'#2d1a00',bonus:'#0a2e1a',penalty:'#2d0a0a',corner:'#050a18'};
const SP_STROKE = {start:'#3b82f6',question:'#2563eb',challenge:'#c2410c',bonus:'#15803d',penalty:'#991b1b',corner:'#1e293b'};
const SP_TEXT   = {start:'#93c5fd',question:'#7dd3fc',challenge:'#fb923c',bonus:'#4ade80',penalty:'#f87171',corner:'#818cf8'};

/* ══════════════════════════════════════
   BOARD GEOMETRY
══════════════════════════════════════ */
function spaceCoords(i) {
  const S=660, M=40, cell=(S-2*M)/10;
  if (i < 10) { const x = S-M - i*cell; return {x:x-cell, y:S-M-cell, w:cell, h:cell}; }
  if (i < 20) { const j=i-10; return {x:S-M-cell, y:S-M-cell - j*cell, w:cell, h:cell}; }
  if (i < 30) { const j=i-20; return {x:M + j*cell, y:M, w:cell, h:cell}; }
  const j=i-30; return {x:M, y:M + j*cell, w:cell, h:cell};
}
function spaceCX(i) { const c=spaceCoords(i); return c.x+c.w/2; }
function spaceCY(i) { const c=spaceCoords(i); return c.y+c.h/2; }

/* ══════════════════════════════════════
   GAME STATE
══════════════════════════════════════ */
let G = {};
let diceAnim = null;
let qTimerInterval = null;
let qTimerSecs = 180;

/* ══════════════════════════════════════
   DRAW BOARD
══════════════════════════════════════ */
function drawBoard() {
  const svg = document.getElementById('board-svg');
  svg.innerHTML = '';
  const ns = 'http://www.w3.org/2000/svg';

  // Background
  const bg = mkEl(ns,'rect',{x:0,y:0,width:660,height:660,fill:'#020817',rx:16});
  svg.appendChild(bg);
  svg.appendChild(mkEl(ns,'rect',{x:2,y:2,width:656,height:656,fill:'none',stroke:'#1e3a5f','stroke-width':2,rx:15}));
  svg.appendChild(mkEl(ns,'rect',{x:38,y:38,width:584,height:584,fill:'none',stroke:'#0f172a','stroke-width':1,rx:4}));

  for (let i = 0; i < BOARD_SIZE; i++) {
    const c = spaceCoords(i);
    const type = SP_TYPES[i];
    const fill   = SP_FILL[type]   || '#0d1f3c';
    const stroke = SP_STROKE[type] || '#1e293b';
    const col    = SP_TEXT[type]   || '#64748b';
    const cx = c.x + c.w/2, cy = c.y + c.h/2;

    // Tile
    svg.appendChild(mkEl(ns,'rect',{x:c.x+1,y:c.y+1,width:c.w-2,height:c.h-2,fill,stroke,'stroke-width':1.5,rx:4}));
    // Top strip
    svg.appendChild(mkEl(ns,'rect',{x:c.x+1,y:c.y+1,width:c.w-2,height:5,fill:stroke,rx:4}));

    // Emoji
    const em = document.createElementNS(ns,'text');
    Object.assign(em, {}); 
    em.setAttribute('x', cx); em.setAttribute('y', cy-5);
    em.setAttribute('text-anchor','middle'); em.setAttribute('font-size','13');
    em.setAttribute('dominant-baseline','middle');
    em.textContent = SP_EMOJI[i] || '';
    svg.appendChild(em);

    // Label
    const lines = (SP_LABELS[i]||'').split('\n');
    lines.forEach((ln, li) => {
      const t = document.createElementNS(ns,'text');
      t.setAttribute('x', cx); t.setAttribute('y', cy + 8 + li*7);
      t.setAttribute('text-anchor','middle'); t.setAttribute('font-size','6.5');
      t.setAttribute('font-family','sans-serif'); t.setAttribute('fill', col);
      t.setAttribute('font-weight','700');
      t.textContent = ln;
      svg.appendChild(t);
    });
  }
  drawTokens();
}

function mkEl(ns, tag, attrs) {
  const el = document.createElementNS(ns, tag);
  for (const [k,v] of Object.entries(attrs)) el.setAttribute(k, v);
  return el;
}

/* ══════════════════════════════════════
   DRAW TOKENS
══════════════════════════════════════ */
function drawTokens() {
  const svg = document.getElementById('board-svg');
  const ns = 'http://www.w3.org/2000/svg';
  svg.querySelectorAll('.tok').forEach(e => e.remove());

  const atPos = {};
  G.teams.forEach((t, ti) => { (atPos[t.pos] = atPos[t.pos]||[]).push(ti); });

  Object.keys(atPos).forEach(pos => {
    const list = atPos[pos];
    const cx = spaceCX(+pos), cy = spaceCY(+pos);
    const n = list.length;

    list.forEach((ti, li) => {
      const ox = n > 1 ? (li - (n-1)/2) * 10 : 0;
      const col = TEAM_COLORS[ti];
      const isActive = (ti === G.turn);
      const g = document.createElementNS(ns,'g');
      g.setAttribute('class','tok');

      if (isActive) {
        // Outer glow rings
        g.appendChild(mkEl(ns,'circle',{cx:cx+ox,cy:cy-3,r:15,fill:'none',stroke:'#fbbf24','stroke-width':2.5,opacity:.8}));
        g.appendChild(mkEl(ns,'circle',{cx:cx+ox,cy:cy-3,r:19,fill:'none',stroke:'#fbbf24','stroke-width':1,opacity:.3}));
      }
      // Shadow
      g.appendChild(mkEl(ns,'ellipse',{cx:cx+ox+1,cy:cy+10,rx:7,ry:3,fill:'rgba(0,0,0,0.5)'}));
      // Base
      g.appendChild(mkEl(ns,'ellipse',{cx:cx+ox,cy:cy+8,rx:7,ry:3.5,fill:col,opacity:.9}));
      // Body
      g.appendChild(mkEl(ns,'rect',{x:cx+ox-4.5,y:cy-1,width:9,height:10,rx:4.5,fill:col}));
      // Neck
      g.appendChild(mkEl(ns,'rect',{x:cx+ox-2.5,y:cy-6,width:5,height:5,fill:col}));
      // Head
      g.appendChild(mkEl(ns,'circle',{cx:cx+ox,cy:cy-9,r:6.5,fill:col}));
      // Shine
      g.appendChild(mkEl(ns,'circle',{cx:cx+ox-2,cy:cy-11,r:2.5,fill:'rgba(255,255,255,0.3)'}));
      // Team number
      const lbl = document.createElementNS(ns,'text');
      lbl.setAttribute('x', cx+ox); lbl.setAttribute('y', cy-7);
      lbl.setAttribute('text-anchor','middle'); lbl.setAttribute('font-size','7');
      lbl.setAttribute('font-family','sans-serif'); lbl.setAttribute('fill','#fff');
      lbl.setAttribute('font-weight','800'); lbl.setAttribute('dominant-baseline','middle');
      lbl.textContent = String(ti+1);
      g.appendChild(lbl);
      // Crown for active
      if (isActive) {
        const crown = document.createElementNS(ns,'text');
        crown.setAttribute('x', cx+ox); crown.setAttribute('y', cy-21);
        crown.setAttribute('text-anchor','middle'); crown.setAttribute('font-size','10');
        crown.textContent = '👑';
        g.appendChild(crown);
      }
      svg.appendChild(g);
    });
  });
}

/* ══════════════════════════════════════
   DICE
══════════════════════════════════════ */
function drawDice(val, rolling) {
  const canvas = document.getElementById('dice-canvas');
  const ctx = canvas.getContext('2d');
  ctx.clearRect(0,0,52,52);
  // Face
  ctx.fillStyle = '#1e293b';
  rrect(ctx,1,1,50,50,10); ctx.fill();
  ctx.strokeStyle = '#6366f1'; ctx.lineWidth = 2;
  rrect(ctx,1,1,50,50,10); ctx.stroke();

  if (rolling) {
    ctx.fillStyle = '#818cf8';
    ctx.font = 'bold 20px sans-serif';
    ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
    ctx.fillText('?', 26, 27);
  } else {
    ctx.fillStyle = '#e2e8f0';
    const DOTS = {
      1:[[26,26]],
      2:[[14,14],[38,38]],
      3:[[14,14],[26,26],[38,38]],
      4:[[14,14],[38,14],[14,38],[38,38]],
      5:[[14,14],[38,14],[26,26],[14,38],[38,38]],
      6:[[14,13],[38,13],[14,26],[38,26],[14,39],[38,39]]
    };
    (DOTS[val]||DOTS[1]).forEach(([dx,dy]) => {
      ctx.beginPath(); ctx.arc(dx,dy,4.5,0,Math.PI*2); ctx.fill();
    });
  }
}
function rrect(ctx,x,y,w,h,r) {
  ctx.beginPath();
  ctx.moveTo(x+r,y); ctx.lineTo(x+w-r,y); ctx.quadraticCurveTo(x+w,y,x+w,y+r);
  ctx.lineTo(x+w,y+h-r); ctx.quadraticCurveTo(x+w,y+h,x+w-r,y+h);
  ctx.lineTo(x+r,y+h); ctx.quadraticCurveTo(x,y+h,x,y+h-r);
  ctx.lineTo(x,y+r); ctx.quadraticCurveTo(x,y,x+r,y); ctx.closePath();
}
function animateDice(finalVal, cb) {
  let frame = 0;
  if (diceAnim) clearInterval(diceAnim);
  diceAnim = setInterval(() => {
    frame++;
    drawDice(Math.floor(Math.random()*6)+1, true);
    if (frame >= 20) { clearInterval(diceAnim); diceAnim = null; drawDice(finalVal, false); cb(); }
  }, 55);
}

/* ══════════════════════════════════════
   HUD
══════════════════════════════════════ */
function updateHUD() {
  const hud = document.getElementById('top-hud');
  const maxScore = Math.max(...G.teams.map(t => t.score), 5);
  const perRow = G.teams.length <= 3 ? G.teams.length : Math.ceil(G.teams.length / 2);
  let html = '';
  for (let r = 0; r < Math.ceil(G.teams.length / perRow); r++) {
    html += '<div class="hud-row">';
    for (let c = 0; c < perRow; c++) {
      const ti = r * perRow + c;
      if (ti >= G.teams.length) break;
      const t = G.teams[ti];
      const pct = Math.min(100, Math.round(t.score / maxScore * 100));
      const active = ti === G.turn ? ' active' : '';
      html += `<div class="hud-team${active}">
        <div class="hud-dot" style="background:${TEAM_COLORS[ti]}"></div>
        <span class="hud-name">${esc(t.name)}</span>
        <div class="hud-bar-wrap"><div class="hud-bar" style="width:${pct}%;background:${TEAM_COLORS[ti]}"></div></div>
        <span class="hud-score">${t.score}pts</span>
        <span class="hud-lap">Lap ${t.laps+1}/2</span>
      </div>`;
    }
    html += '</div>';
  }
  hud.innerHTML = html;
}
function esc(s) { return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }
function setStatus(msg) { document.getElementById('status-txt').textContent = msg; }

/* ══════════════════════════════════════
   GAME FLOW
══════════════════════════════════════ */
function startGame() {
  const teams = [];
  for (let i = 0; i < teamCount; i++) {
    const inp = document.getElementById('tn'+i);
    const name = (inp ? inp.value.trim() : '') || TEAM_DEFAULTS[i];
    teams.push({ name, pos:0, score:0, laps:0 });
  }
  G = { teams, turn:0, rolling:false, waiting:false, currentQ:null };
  document.getElementById('setup').style.display = 'none';
  document.getElementById('game').style.display = 'block';
  drawBoard();
  drawDice(1, false);
  updateHUD();
  setStatus(G.teams[0].name + "'s turn — roll the dice!");
  document.getElementById('roll-btn').textContent = 'Roll for ' + G.teams[0].name;
}

function rollDice() {
  if (G.rolling || G.waiting) return;
  G.rolling = true;
  document.getElementById('roll-btn').disabled = true;
  const val = Math.floor(Math.random()*6)+1;
  animateDice(val, () => { G.rolling = false; moveTeam(val); });
}

function moveTeam(steps) {
  const t = G.teams[G.turn];
  const oldPos = t.pos;
  t.pos = (t.pos + steps) % BOARD_SIZE;
  const passedGo = t.pos < oldPos || (oldPos + steps) >= BOARD_SIZE;
  if (passedGo) {
    t.laps++; t.score++;
    setStatus(t.name + ' passed GO! +1 bonus point 🎉');
    if (t.laps >= 2) { drawTokens(); updateHUD(); setTimeout(showWin, 700); return; }
  } else {
    setStatus(t.name + ' rolled ' + steps + ' → ' + SP_LABELS[t.pos].replace('\n',' '));
  }
  drawTokens(); updateHUD();
  setTimeout(() => handleSpace(t.pos), 500);
}

function handleSpace(pos) {
  const t = G.teams[G.turn];
  const type = SP_TYPES[pos];
  if (type === 'question')  { showQuestion(false); }
  else if (type === 'challenge') { showQuestion(true); }
  else if (type === 'bonus') {
    t.score++; updateHUD();
    setStatus(t.name + ' landed on Bonus! ⭐ +1 free point!');
    showInfo('b', '⭐ Bonus Space!', 'Free point awarded! ' + t.name + ' now has ' + t.score + ' pts.', endTurn);
  } else if (type === 'penalty') {
    t.pos = (t.pos - 3 + BOARD_SIZE) % BOARD_SIZE;
    drawTokens(); updateHUD();
    setStatus(t.name + ' hit a Penalty! 💀 Move back 3 spaces.');
    showInfo('p', '💀 Penalty!', t.name + ' moves back 3 spaces to space ' + t.pos + '.', endTurn);
  } else {
    // corner or start
    setStatus(t.name + ' is on a corner — pass the turn.');
    setTimeout(endTurn, 1200);
  }
}

function showInfo(tagCls, title, msg, cb) {
  const card = document.getElementById('modal-card');
  card.innerHTML = `<span class="m-tag ${tagCls}">${title}</span>
    <div class="q-txt">${msg}</div>
    <div class="m-btns"><button class="m-btn pri" id="infook">Continue →</button></div>`;
  document.getElementById('modal-bg').classList.remove('hidden');
  document.getElementById('infook').onclick = () => {
    document.getElementById('modal-bg').classList.add('hidden');
    cb();
  };
}

/* ══════════════════════════════════════
   TIMER
══════════════════════════════════════ */
function clearQTimer() {
  if (qTimerInterval) { clearInterval(qTimerInterval); qTimerInterval = null; }
}
function startQTimer(total, onExpire) {
  clearQTimer();
  qTimerSecs = total;
  renderTimer(qTimerSecs, total);
  qTimerInterval = setInterval(() => {
    qTimerSecs--;
    renderTimer(qTimerSecs, total);
    if (qTimerSecs <= 0) { clearQTimer(); onExpire(); }
  }, 1000);
}
function renderTimer(remaining, total) {
  const el = document.getElementById('q-timer');
  if (!el) return;
  const m = Math.floor(remaining/60), s = remaining%60;
  const label = m + ':' + String(s).padStart(2,'0');
  const pct = Math.max(0, remaining/total*100);
  const col = remaining > 60 ? '#22c55e' : remaining > 30 ? '#f59e0b' : '#ef4444';
  el.innerHTML = `
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:5px">
      <span style="font-size:10px;color:#475569;font-weight:700;letter-spacing:.05em">⏱ TIME LEFT</span>
      <span style="font-size:14px;font-weight:800;color:${col};font-variant-numeric:tabular-nums">${label}</span>
    </div>
    <div style="height:5px;background:#1e293b;border-radius:3px;overflow:hidden">
      <div style="height:100%;width:${pct}%;background:${col};border-radius:3px;transition:width .9s linear"></div>
    </div>`;
}

/* ══════════════════════════════════════
   QUESTIONS
══════════════════════════════════════ */
let usedQ = [], usedC = [];
function getQ(pool, used) {
  const avail = pool.map((_,i)=>i).filter(i=>!used.includes(i));
  if (!avail.length) { used.length = 0; }
  const avail2 = pool.map((_,i)=>i).filter(i=>!used.includes(i));
  const idx = avail2[Math.floor(Math.random()*avail2.length)];
  used.push(idx);
  return pool[idx];
}

function showQuestion(isChallenge) {
  G.waiting = true;
  const q = isChallenge ? getQ(CHALLENGE_QUESTIONS, usedC) : getQ(ALL_QUESTIONS, usedQ);
  const pts = isChallenge ? 2 : 1;
  const tagTxt = isChallenge ? '🔥 Challenge — +2 pts' : '❓ Question — +1 pt';
  const tagCls = isChallenge ? 'c' : 'q';

  // Shuffle options (Fisher-Yates)
  const idx = [0,1,2,3];
  for (let i = 3; i > 0; i--) {
    const j = Math.floor(Math.random()*(i+1));
    [idx[i],idx[j]] = [idx[j],idx[i]];
  }
  const shuffledOpts = idx.map(i => q.opts[i]);
  const newCorrect = idx.indexOf(q.correct);

  G.currentQ = { pts, correct: newCorrect, exp: q.exp, answered: false };

  const optHTML = shuffledOpts.map((o, i) =>
    `<button class="opt-b" id="qopt${i}">${'ABCD'[i]}. ${o}</button>`
  ).join('');

  const card = document.getElementById('modal-card');
  card.innerHTML = `
    <span class="m-tag ${tagCls}">${tagTxt}</span>
    <div id="q-timer"></div>
    <div class="q-txt">${q.text}</div>
    <div class="opts-grid">${optHTML}</div>
    <div id="qfb"></div>
    <div class="m-btns" id="qbtns" style="display:none">
      <button class="m-btn pri" id="qnext">Next Turn →</button>
    </div>`;

  document.getElementById('modal-bg').classList.remove('hidden');
  document.getElementById('roll-btn').disabled = true;

  // Attach click listeners safely (no inline onclick)
  for (let i = 0; i < 4; i++) {
    (function(idx) {
      const btn = document.getElementById('qopt' + idx);
      if (btn) btn.addEventListener('click', function onOptClick() {
        btn.removeEventListener('click', onOptClick);
        if (!G.currentQ || G.currentQ.answered) return;
        clearQTimer();
        revealAnswer(idx, false);
      });
    })(i);
  }

  // 3-minute countdown
  startQTimer(180, () => {
    if (!G.currentQ || G.currentQ.answered) return;
    revealAnswer(null, true);
  });
}

function revealAnswer(chosen, timedOut) {
  if (!G.currentQ || G.currentQ.answered) return;
  G.currentQ.answered = true;
  clearQTimer();

  const { pts, correct, exp } = G.currentQ;
  const t = G.teams[G.turn];

  // Disable all buttons
  document.querySelectorAll('.opt-b').forEach(b => b.disabled = true);
  // Highlight correct
  const cBtn = document.getElementById('qopt' + correct);
  if (cBtn) cBtn.classList.add('correct');

  let fbHTML = '';
  if (timedOut) {
    fbHTML = `<div class="fb-box bad">⏰ Time's up! The correct answer was ${'ABCD'[correct]}. ${exp}</div>`;
    setStatus(t.name + ' ran out of time!');
  } else {
    const right = (chosen === correct);
    if (!right) {
      const wBtn = document.getElementById('qopt' + chosen);
      if (wBtn) wBtn.classList.add('wrong');
    }
    if (right) {
      t.score += pts;
      fbHTML = `<div class="fb-box ok">✅ Correct! +${pts} pt${pts>1?'s':''}. ${exp}</div>`;
      setStatus(t.name + ' got it right! +' + pts + ' pts. Total: ' + t.score + ' pts.');
    } else {
      fbHTML = `<div class="fb-box bad">❌ Incorrect. Correct was ${'ABCD'[correct]}. ${exp}</div>`;
      setStatus(t.name + ' got it wrong. Better luck next turn!');
    }
  }

  document.getElementById('qfb').innerHTML = fbHTML;
  const qbtns = document.getElementById('qbtns');
  if (qbtns) qbtns.style.display = 'flex';
  const qnext = document.getElementById('qnext');
  if (qnext) qnext.onclick = () => {
    clearQTimer();
    document.getElementById('modal-bg').classList.add('hidden');
    G.waiting = false;
    G.currentQ = null;
    updateHUD();
    endTurn();
  };
  updateHUD();
}

function endTurn() {
  clearQTimer();
  G.turn = (G.turn + 1) % G.teams.length;
  const name = G.teams[G.turn].name;
  setStatus(name + "'s turn — roll the dice!");
  document.getElementById('roll-btn').disabled = false;
  document.getElementById('roll-btn').textContent = 'Roll for ' + name;
  updateHUD();
}

function showWin() {
  document.getElementById('game').style.display = 'none';
  document.getElementById('winscreen').style.display = 'block';
  const winner = G.teams[G.turn];
  document.getElementById('win-title').textContent = '🏆 ' + winner.name + ' Wins!';
  document.getElementById('win-sub').textContent = 'Completed 2 full laps first — excellent cell biology knowledge!';
  const sorted = [...G.teams].sort((a,b) => b.score - a.score);
  document.getElementById('final-scores').innerHTML = sorted.map(t => {
    const ti = G.teams.indexOf(t);
    return `<div class="fs-item">
      <div class="fs-num" style="color:${TEAM_COLORS[ti]}">${t.score}</div>
      <div class="fs-lbl">${esc(t.name)}</div>
    </div>`;
  }).join('');
}

